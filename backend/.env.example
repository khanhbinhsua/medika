
# ── Backup mã hoá + off-site ──────────────────────────────────────────
# Khoá mã hoá file backup (32 byte base64). KHÁC với KEK. Bắt buộc trước off-site.
BACKUP_ENCRYPTION_KEY=
# Off-site (tuỳ chọn): đích S3-compatible (AWS S3 hoặc MinIO tự host trên VPS).
# BACKUP_S3_BUCKET=crm-backups
# BACKUP_S3_ENDPOINT=http://minio:9000
# BACKUP_S3_FORCE_PATH_STYLE=true
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=backups/

# ── Thông báo đa kênh (Zalo ZNS / SMS Brandname / Email) ──────────────
# Thứ tự fallback: thử lần lượt tới khi có kênh gửi được.
NOTIFY_CHANNEL_ORDER=zalo,sms,email

# Zalo ZNS — dev 'mock' (chỉ log, không gọi API thật); production 'zns'.
ZALO_PROVIDER=mock
# ZALO_ACCESS_TOKEN=            # bắt buộc khi ZALO_PROVIDER=zns
# ZALO_ZNS_ENDPOINT=https://business.openapi.zalo.me/message/template

# SMS Brandname — dev 'console'; VN 'esms' (eSMS.vn); quốc tế 'twilio'.
SMS_PROVIDER=console
# ESMS_API_KEY=
# ESMS_SECRET_KEY=
# ESMS_BRANDNAME=CRMYTE
# ESMS_ENDPOINT=https://rest.esms.vn/MainService.svc/json/SendMultipleMessage_V4_post_json/

# Email (dev = Mailhog localhost:1025). Production: SMTP đã ký BAA.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# NOTIFY_FROM_EMAIL=no-reply@crm-dk.local

# Bảo vệ webhook read-receipt (Zalo gọi vào). Production BẮT BUỘC đặt.
# NOTIFY_WEBHOOK_SECRET=

# Bí mật chia sẻ với DK-link cho webhook "bệnh nhân mới" (POST /api/dklink/webhook/patient).
# DK-link gửi header `Authorization: Bearer <giá trị này>`; phải TRÙNG với
# integration_settings.crm_webhook_secret bên DK-link. Production BẮT BUỘC đặt.
# DKLINK_WEBHOOK_SECRET=
