{
  "name": "@crm-dk/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API cho CRM Y Tế HIPAA-compliant",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate -m migrations -j sql --envPath .env",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down 1",
    "migrate:create": "npm run migrate -- create -- --migration-file-language sql",
    "seed": "tsx src/db/seed.ts",
    "seed:icd10": "tsx src/db/seed-icd10.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "dev:reset-mfa": "tsx src/db/reset-dev-mfa.ts",
    "smoke": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-test.mjs",
    "smoke:phase2": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-phase2.mjs",
    "smoke:phase3": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-phase3.mjs",
    "load-test": "node scripts/load-test.mjs",
    "smoke:purge": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-purge.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "verify:encryption": "tsx src/db/verify-encryption-at-rest.ts",
    "reminders:dispatch": "tsx src/jobs/dispatch-reminders.ts",
    "smoke:reminders": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-reminders.mjs",
    "smoke:reports": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-reports.mjs",
    "smoke:conditions": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-conditions.mjs",
    "smoke:portal": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-portal.mjs",
    "smoke:notifications": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-notifications.mjs",
    "smoke:treatment": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-treatment.mjs",
    "smoke:marketing": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-marketing.mjs",
    "smoke:survey": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-survey.mjs",
    "audit:partition": "tsx src/jobs/create-audit-partition.ts",
    "test:vault": "tsx scripts/test-vault-kek.mjs",
    "test:vault-approle": "tsx scripts/test-vault-approle.mjs",
    "smoke:users": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-users.mjs",
    "owner:account": "tsx scripts/create-owner-account.ts",
    "smoke:spending": "tsx src/db/reset-dev-mfa.ts && node scripts/smoke-spending.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1113.0",
    "@aws-sdk/client-s3": "^3.1113.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.5",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "otplib": "^12.0.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^2.0.3",
    "eslint": "^8.57.0",
    "node-pg-migrate": "^6.2.2",
    "pino-pretty": "^11.2.1",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
