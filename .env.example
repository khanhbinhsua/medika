# ─────────────────────────────────────────────────────────────
# CRM Y Tế — biến môi trường mẫu
# Copy thành .env và điền giá trị thật. KHÔNG commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4100
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://crm_app:changeme@localhost:5433/crm_dk
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ── JWT & Session ─────────────────────────────────────────────
# Sinh secret: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=86400
SESSION_IDLE_TIMEOUT_SECONDS=1800

# ── Mã hoá ────────────────────────────────────────────────────
# local: dev only. Production BẮT BUỘC aws-kms (AWS) hoặc vault (VPS tự host).
KEK_PROVIDER=local
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEK_LOCAL_KEY=
KEK_AWS_KMS_ARN=
# Vault (KEK tự host trên VPS thay AWS KMS). Production nên dùng AppRole
# (role-id + secret-id → token ngắn hạn least-privilege) thay token tĩnh:
# VAULT_ADDR=http://vault:8200
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_TOKEN=            # thay thế cho AppRole (kém an toàn hơn, chỉ dev)
# VAULT_TRANSIT_KEY=crm-dk-kek
# Khoá HMAC cho search hash — KHÁC với KEK. Sinh giống trên.
SEARCH_HMAC_KEY=

# ── Bảo mật ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
MFA_ISSUER=CRM Y Te
MFA_REQUIRED=true

# ── Docker Compose ────────────────────────────────────────────
POSTGRES_USER=crm_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crm_dk
# Đổi nếu 5433 cũng đã bị chiếm
POSTGRES_HOST_PORT=5433

# ── Frontend (Vite) ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4100/api
